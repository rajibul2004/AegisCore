# Server Configuration
PORT=5000
NODE_ENV=production
BACKEND_URL=https://your-app.onrender.com

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/crimeDB?retryWrites=true&w=majority

# JWT Secret (use any random long string)
JWT_SECRET=your_jwt_secret_key_here

# Groq AI
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=openai/gpt-oss-20b

# Cloudinary (Evidence and Image Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Brevo SMTP Configuration (Email Notifications & 2FA)
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_USER=your_smtp_user@smtp-brevo.com
SMTP_PASS=your_smtp_password
SMTP_FROM="AegisCore Security" <security@yourdomain.com>
SENDER_EMAIL=security@yourdomain.com
