# Server Configuration
PORT=5000
NODE_ENV=development

# Frontend URL (for CORS)
CLIENT_URL=http://localhost:5173

# MongoDB Atlas Connection String
# Replace <username>, <password>, and <cluster-name> with your actual values
MONGO_URI=mongodb+srv://<username>:<password>@<cluster-name>.mongodb.net/crimeDB?retryWrites=true&w=majority

# JWT Secret (use any random long string)
JWT_SECRET=your_jwt_secret_key_here

# Groq AI (will be added later)
# GROQ_API_KEY=your_groq_api_key

# AWS S3 (will be added later)
# AWS_ACCESS_KEY_ID=your_aws_key
# AWS_SECRET_ACCESS_KEY=your_aws_secret
# AWS_S3_BUCKET=your_bucket_name
# AWS_REGION=ap-south-1
